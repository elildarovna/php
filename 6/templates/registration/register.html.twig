<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Регистрация</title></head>
<body>
{% for message in app.flashes('success') %}
    <p>{{ message }}</p>
{% endfor %}

{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.name) }}
    {{ form_row(form.plainPassword) }}
    <button type="submit">Зарегистрироваться</button>
{{ form_end(form) }}
</body>
</html>
