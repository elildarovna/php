<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Календарь</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        table {
            border-collapse: collapse;
        }

        th, td {
            width: 70px;
            height: 45px;
            text-align: center;
        }

        .table th, .table td {
            border: 1px solid black;
        }

        .weekends th, .weekends td {
            border: none;
        }

        .weekends th:nth-child(6),
        .weekends th:nth-child(7),
        .weekends td:nth-child(6),
        .weekends td:nth-child(7) {
            color: red;
        }

        .list div {
            margin-bottom: 6px;
        }
    </style>
</head>
<body>
    <h1>{{ monthName }} {{ year }}</h1>

    {% if format == 'list' %}
        <div class="list">
            {% for day in days %}
                <div>{{ day.number }} — {{ day.name }}</div>
            {% endfor %}
        </div>
    {% else %}
        <table class="{{ format }}">
            <thead>
                <tr>
                    <th>Пн</th>
                    <th>Вт</th>
                    <th>Ср</th>
                    <th>Чт</th>
                    <th>Пт</th>
                    <th>Сб</th>
                    <th>Вс</th>
                </tr>
            </thead>
            <tbody>
                {% for week in calendar %}
                    <tr>
                        {% for day in week %}
                            <td>{{ day }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</body>
</html>
